# === Segredos / ambiente ===
.env
.env.local
*.key

# === Python ===
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# === Node / frontend ===
node_modules/
dist/
.vite/
*.local

# === OS ===
.DS_Store

# === Dados sensíveis / PII / LGPD ===
# Dados granulares (brutos e silver) não vão para o versionamento.
# Eles vivem localmente; o app os lê do disco. Os agregados em gold/ (nível de área,
# sem dado individual) podem ser versionados.
/dados/
/dados_normalizados/silver/

# === Modelo preditivo ===
# Saídas auxiliares do notebook (painel hex, predições por horizonte, .tex etc.)
# que NÃO são consumidas pelo frontend. Os artefatos consumidos vivem em
# app/frontend/public/compstat/ e ESSES sim são versionados.
/modelo_preditivo/output/

# === Artefatos de compilação LaTeX (docs/guia/) ===
# O .tex é versionado; o PDF e os arquivos auxiliares (aux, log, toc, out)
# são gerados localmente ou no Overleaf.
/docs/guia/*.aux
/docs/guia/*.log
/docs/guia/*.out
/docs/guia/*.toc
/docs/guia/*.pdf
